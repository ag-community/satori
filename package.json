{
  "name": "satori",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "check": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "pnpm run test:unit -- --run",
    "format": "biome check --write .",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@inlang/paraglide-js": "^3.2.2",
    "@sveltejs/adapter-node": "6.0.4",
    "@sveltejs/kit": "3.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^26",
    "svelte": "5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "bits-ui": "^2.21.0",
    "chart.js": "^4.6.1",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "runed": "^0.38.0",
    "svelte-dnd-action": "^0.9.80"
  }
}
